# VALORAIPLUS®️ Voyager-Enterprise Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# Do not commit the .env file to version control.

# --- Blockchain Network RPC Endpoints ---
# Replace with your actual RPC URLs from providers like Infura, Alchemy, or your own node.
VALORCHAIN_G_RPC_URL="https://rpc.valorchain-g.net"
ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID"
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID"

# --- Wallet Private Key ---
# The private key of the account you want to use for deployments.
# WARNING: Keep this key secure and secret. Do not expose it publicly.
# For security, this should be a dedicated deployer account with limited funds.
PRIVATE_KEY="YOUR_EVM_PRIVATE_KEY_HERE"

# --- Etherscan API Key (for contract verification) ---
ETHERSCAN_API_KEY="YOUR_ETHERSCAN_API_KEY_HERE"

# --- Bitcoin Network Configuration (for OP_RETURN anchoring) ---
# Note: The current implementation simulates Bitcoin transactions.
# For real transactions, you would need a funded Bitcoin wallet and RPC access.
BITCOIN_NETWORK="testnet" # "mainnet" or "testnet"
BITCOIN_RPC_USER="your_rpc_user"
BITCOIN_RPC_PASS="your_rpc_password"
BITCOIN_RPC_HOST="127.0.0.1"
BITCOIN_RPC_PORT="18332" # 8332 for mainnet, 18332 for testnet