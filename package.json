{
  "name": "valorailegal",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:rust": "cd services/rust-worker && cargo run",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:rust\"",
    "db:up": "docker compose up -d postgres redis",
    "up": "docker compose up --build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
