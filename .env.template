# --- Hardhat networks ---
RPC_URL_SEPOLIA=
PRIVATE_KEY=

# --- IPFS endpoints (comma-separated). Each should be the base URL (without /api/v0). Example: http://127.0.0.1:5001 ---
IPFS_API_URLS=http://127.0.0.1:5001

# Optional: Pin notarization receipt automatically
PIN_RECEIPT=1

# Optional: Case-manager webhook to receive live CID payloads
CASE_MANAGER_WEBHOOK=

# Optional: path to a token/logo asset (will be pinned and referenced in tokenlist logoURI)
TOKEN_LOGO=assets/brand/valor_ai_plus_logo.svg

# Optional: override default notary id / domain separation tag
NOTARY_ID=VALORAIPLUS
